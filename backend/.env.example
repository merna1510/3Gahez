# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local:  mongodb://127.0.0.1:27017/social_media_api
# Atlas:  mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/social_media_api
MONGODB_URI=mongodb://127.0.0.1:27017/social_media_api

# Authentication
# Generate a long random secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
# Vite uses 5173 by default; Create React App uses 3000.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional: use a specific MongoDB for tests. If omitted, the tests use
# mongodb://127.0.0.1:27017/social_media_api_test and fall back to an
# isolated in-memory MongoDB process when no local server is available.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/social_media_api_test
